/// Commonly used mathematical functions and constants
/// All constants are verified via oeis.org when available, and are rounded to 160 digits
/// Note that oeis generally does not have more digits than 150 digits, and as such constants are checked up to the digits available and are then extended using other tools

/// Archimedes' constant (π)
/// OEIS number: A000796
/// Verified to 105 digits as of 2026
pub let PI = 3.141592653589793238462643383279502884197169399375105820974944592307816406286208998628034825342117067982148086513282306647093844609550582231725359408128481117450;

/// Circle constant (2π or τ)
/// OEIS number: A019692
/// Verified to 99 digits as of 2026
pub let TAU = 6.283185307179586476925286766559005768394338798750211641949889184615632812572417997256069650684234135964296173026564613294187689219101164463450718816256962234901;

/// Euler's number (e)
/// OEIS number: A001113
/// Verified to 105 digits as of 2026
pub let E = 2.718281828459045235360287471352662497757247093699959574966967627724076630353547594571382178525166427427466391932003059921817413596629043572900334295260595630738;


/// Golden ratio constant Φ = (1 + sqrt(5))/2
/// OEIS number: A001622
/// Verified to 105 digits as of 2026
pub let PHI = 1.618033988749894848204586834365638117720309179805762862135448622705260462818902449707207204189391137484754088075386891752126633862223536931793180060766726354433;

/// ln(10)
/// OEIS number: A002392
/// Verified to 87 digits as of 2026
pub let LN10 = 2.302585092994045684017991454684364207601101488628772976033327900967572609677352480235997205089598298341967784042286248633409525465082806756666287369098781689483;

/// ln(2)
/// OEIS number: A002162
/// Verified to 100 digits as of 2026
pub let LN2 = 0.6931471805599453094172321214581765680755001343602552541206800094933936219696947156058633269964186875420014810205706857336855202357581305570326707516350759619307;

/// sqrt(2)
/// OEIS number: A002162
/// Verified to 99 digits as of 2026
pub let SQRT2 = 1.414213562373095048801688724209698078569671875376948073176679737990732478462107038850387534327641572735013846230912297024924836055850737212644121497099935831413;


pub fn cos(
    $T: T <= ArithFloatI, 
    theta: T,
    tolerance: comptime_float = 0.0000000001,
    ) 
    -> T {
    let mut x: T = theta;
    while x > PI {
        x = x - TAU;
    }
    while x < -PI {
        x = x + TAU; 
    }
    let mut result: T = 0;

    let term: T = 0;
    let sign: 1 | -1 = 1;
    let power: u32 = 0;

    while abs(term) > tolerance {
        result = result + ( sign * term );

        power = power + 2;
        term = term * (x * x) / (power * (power - 1));
        sign = sign * -1;
    }
    result
}
