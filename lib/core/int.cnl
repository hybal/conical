
mod type enum {
    ArithIntI: ArithIntI,
    comptime_int: comptime_int,
    Int: Int, 
    ModularInt: ModularInt,
    u1: u1,     
    u8: u8,                     
    i8: i8,                     
    u16: u16,
    i16: i16,                   
    u32: u32,                   
    i32: i32,                   
    u64: u64,                   
    i64: i64,                   
    u128: u128,
    i128: i128,
};




/// Helper functions
fn unchecked_cast($A, B: type, val: A) B => {
    __intrin_reinterpret(val, B)
}



